# Secret de la fonction delete-account. Valeur exacte de l’origine du site, sans chemin.
ALLOWED_ORIGIN=https://klirprospect.example

# Injectées par la plateforme Supabase au déploiement. Ne jamais les committer
# ni les passer à tools/build.mjs.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Checkout Stripe de test, prévisualisation uniquement. Laisser désactivé pour
# garder l'achat fermé. Ne jamais mettre sk_live_, rk_live_ ou une clé réelle.
# STRIPE_TEST_CHECKOUT_ENABLED=1
# KLIR_ENV=preview
# STRIPE_TEST_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_TEST_PRICE_ID=
