# Variables publiques lues uniquement par `npm run build`.
# Ne jamais y placer de secret, de service_role, ni de sb_secret_.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Non lue par le build. Secret de la fonction delete-account :
# origine exacte du site, par exemple http://127.0.0.1:3000 en local
# ou https://votredomaine.example en production.
# ALLOWED_ORIGIN=
