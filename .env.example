# Variables publiques injectées dans dist/config.js par tools/build.mjs.
# Placeholders uniquement. Ne jamais committer de vraie clé, de secret ou de mot de passe.
# Ne jamais mettre SUPABASE_SERVICE_ROLE_KEY ici.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Les projets Supabase existent déjà, organisation Klirline INC, région ca-central-1 :
# - production : KlirProspect, ref cbklwmjudobqwbkbxqgy
# - test : KlirProspect Test, ref pwakjxjjxswdjsapsbxn
# Le build Cloudflare a besoin de SUPABASE_URL et de SUPABASE_PUBLISHABLE_KEY
# (Workers Builds, Build variables). Production ou Test : voir README.md
# et README-DEPLOIEMENT.md. Copier ce fichier vers .env.local en local.
# Ne jamais committer les valeurs réelles.

# Variables hors client, à poser seulement au déploiement de la fonction delete-account.
# Elles ne sont pas lues par le build statique.
# ALLOWED_ORIGIN=https://klirprospect.example
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont injectées par Supabase dans la fonction.
# Ne pas les committer et ne pas les recopier dans l’environnement de build.
