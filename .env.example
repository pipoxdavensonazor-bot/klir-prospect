# Variables publiques injectées dans dist/config.js par tools/build.mjs.
# Ne jamais mettre SUPABASE_SERVICE_ROLE_KEY, une clé secrète ou un mot de passe ici.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Réglage manquant : un projet Supabase vide, dédié à KlirProspect.
# Le projet déjà accessible (KlirlienCORE, ref bhyhcbfmkdpmqivnqwsb) n’est pas cette cible.

# Variables hors client, à poser seulement au déploiement de la fonction delete-account.
# Elles ne sont pas lues par le build statique.
# ALLOWED_ORIGIN=https://klirprospect.example
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont injectées par Supabase dans la fonction.
# Ne pas les committer et ne pas les recopier dans l’environnement de build.
